<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow plain HTTP to localhost (emulator). Android's config format has
    no CIDR/range syntax, so a literal LAN entry here (e.g. 192.168.0.0) only
    ever matches that exact address, never an actual device IP — physical
    devices should go through ngrok (HTTPS) instead, per the base-config below. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
    <!-- ngrok tunnels use HTTPS so no special config needed -->
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
